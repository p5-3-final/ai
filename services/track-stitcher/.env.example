# track-stitcher 단독 실행용 예시. 비밀값은 넣지 않는다(로컬 compose 값은 docs local/.env.example).
KAFKA_BOOTSTRAP=localhost:9092
TRACK_STITCHER_REDIS_URL=redis://localhost:6379/0
TRACK_STITCHER_PROFILE_PATH=services/track-stitcher/profiles/local.toml
TRACK_STITCHER_SWEEP_INTERVAL_S=30
TRACK_STITCHER_FINALIZE_LEASE_S=300
S3_BUCKET=vlm-media
S3_ENDPOINT_URL=http://localhost:8333
S3_PATH_STYLE=true
STAGE_TIMING_PUBLISH=false
