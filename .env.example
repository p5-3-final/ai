# compose 없이 서비스를 단독 실행할 때 쓰는 값(예: uv run --package normalize python -m normalize).
# compose로 띄울 때 쓰는 값은 docs 레포 local/.env.example과 local/docker-compose.yml에 있다. .env는 커밋하지 않는다.

# 공통
LOG_LEVEL=INFO
KAFKA_BOOTSTRAP=localhost:9092
HEALTH_PORT=8000
# 처리 시간 측정 묶음을 stage.timing에 발행(SPEC-013). 끄면 JSON 로그로만 남긴다
STAGE_TIMING_PUBLISH=false

# 객체 저장소(로컬 SeaweedFS). 자격 증명은 boto3 기본 체인으로 읽는다.
S3_BUCKET=vlm-media
S3_ENDPOINT_URL=http://localhost:8333
S3_PATH_STYLE=true
S3_REGION=us-east-1
# docs 레포 local/seaweedfs/s3.json의 로컬 전용 샘플 키
AWS_ACCESS_KEY_ID=local-normalize-key
AWS_SECRET_ACCESS_KEY=local-normalize-secret

# normalize (SPEC-007). 비우면 기본값을 쓴다.
NORMALIZE_WORK_DIR=/tmp/normalize
NORMALIZE_MIN_DURATION_S=1
NORMALIZE_MAX_DURATION_S=14400
NORMALIZE_MAX_FPS=30
NORMALIZE_HLS_SEGMENT_S=6
# 정규화 방식을 바꾸면 올린다. 같은 영상도 새 normalizationId로 저장된다
NORMALIZE_VERSION=normalize-v1

# ai-gateway (SPEC-009). 실행: uv run --package ai-gateway uvicorn --factory ai_gateway.main:production_app --port 8000
# 마이그레이션은 먼저 한 번: uv run --package ai-gateway python -m ai_gateway.db.migrate
AI_GATEWAY_DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai_db
AI_GATEWAY_PROFILE_PATH=services/ai-gateway/profiles/local-mock.toml
# Prompt Registry 폴더: services/ai-gateway/registry/prompts와 계약의 taxonomy/를 합친 배치
# (prompts/, taxonomy/). 이미지는 /app/registry에 합쳐 두므로 보통은 compose로 띄운다
AI_GATEWAY_REGISTRY_DIR=
# 모델 버킷의 Registry 묶음(프롬프트·분류 체계·프로필, SPEC-009 R-26). 둘 다 채우면 REGISTRY_DIR 대신 묶음을
# 받아 쓰고, PROFILE_PATH는 묶음 안의 상대 경로(profiles/local-mock.toml)로 준다. 비우면 이미지·폴더를 쓴다
# 묶음 만들기: uv run --package ai-gateway python -m ai_gateway.registry_bundle <registry> <profiles> <출력>
AI_GATEWAY_REGISTRY_BUNDLE=
AI_GATEWAY_REGISTRY_BUNDLE_SHA256=
# mock Adapter는 CI·로컬 전용이다. 운영에서는 켜지 않는다
AI_GATEWAY_ALLOW_MOCK=true
AI_GATEWAY_GROUP_ID=ai-gateway
# 처리 시간 측정 묶음을 stage.timing에 발행(SPEC-013). 끄면 JSON 로그로만 남긴다
AI_GATEWAY_STAGE_TIMING_PUBLISH=false
# openai Adapter를 쓸 때만. 비밀값이라 커밋하지 않는다
AI_GATEWAY_OPENAI_API_KEY=
# 인코더 가중치를 받는 모델 버킷과 로컬 캐시(SPEC-011). open_clip 인코더 프로필(local.toml)일 때만 쓴다
AI_GATEWAY_MODELS_BUCKET=vlm-models
AI_GATEWAY_MODEL_CACHE_DIR=/tmp/vlm-models

# chunk-processor (SPEC-014): test 전용 대역만 제공. 운영 활성화하지 않는다.
CHUNK_PROCESSOR_ENABLED=false
CHUNK_PROCESSOR_ENVIRONMENT=production
CHUNK_PROCESSOR_ADAPTER=unconfigured
CHUNK_PROCESSOR_DATABASE_URL=postgresql+asyncpg://chunk_processor:password@localhost:5432/chunk_processor_db
CHUNK_PROCESSOR_KAFKA_BOOTSTRAP=localhost:9092
CHUNK_PROCESSOR_GROUP_ID=chunk-processor-v1
CHUNK_PROCESSOR_WORK_DIR=/work
CHUNK_PROCESSOR_PUBLISH_INTERVAL_S=1
# environment=test에서만 선택한다. 실제 모델 결과가 아니다.
CHUNK_PROCESSOR_VERIFICATION_OUTCOME=success
